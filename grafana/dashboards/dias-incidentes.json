{
  "uid": "dias-incidentes",
  "title": "Días sin incidentes",
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "America/Guatemala",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "🇬🇹 Guatemala",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 7 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "monitoreo-pg" },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT (CURRENT_DATE - MAX(incident_date))::int AS dias FROM incidents WHERE country = 'GT'" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "red" }, { "value": 7, "color": "yellow" }, { "value": 30, "color": "green" } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
