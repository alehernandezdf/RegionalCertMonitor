          { "matcher": { "id": "byName", "options": "Tipo" }, "properties": [{ "id": "custom.width", "value": 50 }] },
          { "matcher": { "id": "byName", "options": "Error" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "auto", "wrapText": true } }] }
