      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "monitoreo-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT to_char((created_at AT TIME ZONE 'America/Guatemala'), 'DD/MM HH24:MI:SS') AS \"Fecha/Hora\", country AS \"País\", certification_type AS \"Tipo\", COALESCE(event_error_message, '') AS \"Error\" FROM monitoring_results WHERE result_status = false AND transaction_time_ms = 0 ORDER BY created_at DESC LIMIT 8"
